{% extends 'base.html.twig' %}

{% block title %}{{ name }}{% endblock %}

{% block nav %}
    <header class="site-nav">
        <div class="site-nav__inner">
            <span class="site-nav__name">{{ name }}</span>
            <nav class="site-nav__links">
                <a href="#about">À propos</a>
                {% if projects|length > 0 %}
                    <a href="#projects">Projets</a>
                {% endif %}
            </nav>
        </div>
    </header>
{% endblock %}

{% block body %}
    <section class="hero" data-site-nav-target="hero">
        <h1>{{ name }}</h1>
        <div class="scroll-cue" aria-hidden="true">
            <span class="scroll-cue__chevron"></span>
        </div>
    </section>

    <section class="about" id="about">
        <img class="about-photo" src="{{ asset('images/profile.png') }}" alt="Photo de {{ name }}">

        <div class="about-content">
            <h2>À propos de moi</h2>
            {% for paragraph in about %}
                <p>{{ paragraph }}</p>
            {% endfor %}
            {% if highlights|length > 0 %}
                <ul class="about-highlights">
                    {% for highlight in highlights %}
                        <li>{{ highlight }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>

        {% if stats|length > 0 %}
            <div class="about-stats">
                {% for stat in stats %}
                    <div class="about-stats__item">
                        <span class="about-stats__number">{{ stat.number }}</span>
                        <span class="about-stats__label">{{ stat.label }}</span>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        {% if skills|length > 0 %}
            <ul class="project-card__stack about-skills">
                {% for skill in skills %}
                    <li>{{ skill }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    {% if projects|length > 0 %}
        <section class="projects" id="projects">
            <h2>Projets</h2>
            <div class="projects__list">
                {% for project in projects %}
                    <article class="project-card">
                        {% if project.images|length > 0 %}
                            <div class="project-card__carousel" data-controller="carousel">
                                <div class="project-card__track" data-carousel-target="track">
                                    {% for image in project.images %}
                                        <img class="project-card__image" src="{{ asset('uploads/projects/' ~ image.imageName) }}" alt="{{ project.title }}" loading="lazy">
                                    {% endfor %}
                                </div>
                                {% if project.images|length > 1 %}
                                    <button type="button" class="project-card__nav project-card__nav--prev" data-action="carousel#prev" aria-label="Image précédente">‹</button>
                                    <button type="button" class="project-card__nav project-card__nav--next" data-action="carousel#next" aria-label="Image suivante">›</button>
                                {% endif %}
                            </div>
                        {% endif %}

                        <div class="project-card__body">
                            <h3>{{ project.title }}</h3>
                            <p>{{ project.description }}</p>
                            <ul class="project-card__stack">
                                {% for tech in project.stackList %}
                                    <li>{{ tech }}</li>
                                {% endfor %}
                            </ul>
                            <div class="project-card__links">
                                {% if project.githubUrl %}
                                    <a href="{{ project.githubUrl }}" target="_blank" rel="noopener">GitHub →</a>
                                {% endif %}
                                {% if project.demoUrl %}
                                    <a href="{{ project.demoUrl }}" target="_blank" rel="noopener">Démo →</a>
                                {% endif %}
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>
    {% endif %}
{% endblock %}
