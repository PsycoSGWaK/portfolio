{% extends 'base.html.twig' %}

{% block title %}{{ name }}{% endblock %}

{% block nav %}
    <header class="site-nav">
        <div class="site-nav__inner">
            <span class="site-nav__name">{{ name }}</span>
            <div class="site-nav__right">
                <nav class="site-nav__links" data-turbo="false">
                    <a href="#about">À propos</a>
                    {% if experiences|length > 0 %}
                        <a href="#experience">Expérience</a>
                    {% endif %}
                    {% if educations|length > 0 %}
                        <a href="#education">Formation</a>
                    {% endif %}
                    {% if projects|length > 0 %}
                        <a href="#projects">Projets</a>
                    {% endif %}
                    {% if certificates|length > 0 %}
                        <a href="#certificates">Certificats</a>
                    {% endif %}
                </nav>
                {{ include('_theme_toggle.html.twig') }}
            </div>
        </div>
    </header>
{% endblock %}

{% block body %}
    <section class="about" id="about">
        {% if profile and profile.photoName %}
            <img class="about-photo" src="{{ asset('uploads/profile/' ~ profile.photoName) }}" alt="Photo de {{ name }}">
        {% else %}
            <img class="about-photo" src="{{ asset('images/profile.png') }}" alt="Photo de {{ name }}">
        {% endif %}

        <div class="about-content">
            <h2>À propos de moi</h2>
            {% for paragraph in about %}
                <p>{{ paragraph }}</p>
            {% endfor %}
            {% if highlights|length > 0 %}
                <ul class="about-highlights">
                    {% for highlight in highlights %}
                        <li>{{ highlight }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>

        {% if stats|length > 0 %}
            <div class="about-stats">
                {% for stat in stats %}
                    <div class="about-stats__item">
                        <span class="about-stats__number">{{ stat.number }}</span>
                        <span class="about-stats__label">{{ stat.label }}</span>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        {% if skills|length > 0 %}
            <ul class="project-card__stack about-skills">
                {% for skill in skills %}
                    <li>{{ skill }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    {% if experiences|length > 0 %}
        <section class="experience" id="experience">
            <h2>Expérience</h2>
            <div class="experience__list">
                {% for experience in experiences %}
                    {% set logoSrc = experience.logoUrl ?: (experience.logoName ? asset('uploads/logos/' ~ experience.logoName) : null) %}
                    <article class="experience-item">
                        <div class="experience-item__card">
                            <div class="experience-item__header">
                                {% if logoSrc %}
                                    <img class="experience-item__logo" src="{{ logoSrc }}" alt="">
                                {% endif %}
                                <div class="experience-item__heading">
                                    <p class="experience-item__period">{{ experience.period }}</p>
                                    <h3>{{ experience.role }}</h3>
                                    <p class="experience-item__company">
                                        {{ experience.company }}{% if experience.location %} · {{ experience.location }}{% endif %}
                                    </p>
                                </div>
                            </div>
                            {% if experience.descriptionLines|length > 0 %}
                                <ul class="experience-item__description">
                                    {% for line in experience.descriptionLines %}
                                        <li>{{ line }}</li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {% if educations|length > 0 %}
        <section class="education" id="education">
            <h2>Parcours académique</h2>
            <div class="education__list">
                {% for education in educations %}
                    {% set logoSrc = education.logoUrl ?: (education.logoName ? asset('uploads/logos/' ~ education.logoName) : null) %}
                    <article class="education-item">
                        <div class="education-item__card">
                            <div class="education-item__header">
                                {% if logoSrc %}
                                    <img class="education-item__logo" src="{{ logoSrc }}" alt="">
                                {% endif %}
                                <div class="education-item__heading">
                                    <p class="education-item__period">{{ education.period }}</p>
                                    <h3>{{ education.degree }}</h3>
                                    <p class="education-item__school">
                                        {{ education.school }}{% if education.location %} · {{ education.location }}{% endif %}
                                    </p>
                                </div>
                            </div>
                            {% if education.descriptionLines|length > 0 %}
                                <ul class="education-item__description">
                                    {% for line in education.descriptionLines %}
                                        <li>{{ line }}</li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {% if projects|length > 0 %}
        <section class="projects" id="projects">
            <h2>Projets</h2>
            <div class="projects__list">
                {% for project in projects %}
                    {% set coverImage = project.images|length > 0 ? project.images|first : null %}
                    <article class="project-card">
                        {% if project.coverVideoName %}
                            <video class="project-card__image" data-controller="cover-video"
                                   src="{{ asset('uploads/projects/' ~ project.coverVideoName) }}"
                                   autoplay muted loop playsinline></video>
                        {% elseif coverImage %}
                            <img class="project-card__image" src="{{ asset('uploads/projects/' ~ coverImage.imageName) }}" alt="{{ project.title }}" loading="lazy">
                        {% endif %}

                        <div class="project-card__body">
                            {% if project.wip %}
                                <h3>{{ project.title }} - WIP</h3>
                            {% else %}
                                <h3><a href="{{ path('project_show', {slug: project.slug}) }}" class="project-card__stretched-link">{{ project.title }}</a></h3>
                            {% endif %}
                            <p>{{ project.description }}</p>
                            <ul class="project-card__stack">
                                {% for tech in project.stackList %}
                                    <li>{{ tech }}</li>
                                {% endfor %}
                            </ul>
                            <div class="project-card__links">
                                {{ include('project/_links.html.twig', {project: project}) }}
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {% if certificates|length > 0 %}
        <section class="certificates" id="certificates">
            <h2>Certificats</h2>
            <div class="certificates__list">
                {% for certificate in certificates %}
                    <article class="certificate-card">
                        <div class="certificate-card__badge">
                            {% if certificate.badgeImageName %}
                                <img src="{{ asset('uploads/certificates/' ~ certificate.badgeImageName) }}" alt="">
                            {% else %}
                                <span class="certificate-card__initial">{{ certificate.title|first|upper }}</span>
                            {% endif %}
                        </div>
                        <div class="certificate-card__body">
                            <h3>{{ certificate.title }}</h3>
                            <p class="certificate-card__issuer">{{ certificate.issuer }}</p>
                            {% if certificate.issueDate %}
                                <p class="certificate-card__date">{{ certificate.issueDate|format_date(pattern: 'MMMM yyyy') }}</p>
                            {% endif %}
                            {% if certificate.credentialUrl %}
                                <a href="{{ certificate.credentialUrl }}" target="_blank" rel="noopener" class="certificate-card__link">Vérifier →</a>
                            {% endif %}
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>
    {% endif %}
{% endblock %}
