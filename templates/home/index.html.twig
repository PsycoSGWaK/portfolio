{% extends 'base.html.twig' %}

{% block title %}{{ name }}{% endblock %}

{% block nav %}
    <header class="site-nav">
        <div class="site-nav__inner">
            <span class="site-nav__name">{{ name }}</span>
            <nav class="site-nav__links">
                <a href="#about">À propos</a>
                {% if experiences|length > 0 %}
                    <a href="#experience">Expérience</a>
                {% endif %}
                {% if projects|length > 0 %}
                    <a href="#projects">Projets</a>
                {% endif %}
                {% if certificates|length > 0 %}
                    <a href="#certificates">Certificats</a>
                {% endif %}
            </nav>
        </div>
    </header>
{% endblock %}

{% block body %}
    <section class="hero" data-site-nav-target="hero">
        <h1>{{ name }}</h1>
        <div class="scroll-cue" aria-hidden="true">
            <span class="scroll-cue__chevron"></span>
        </div>
    </section>

    <section class="about" id="about">
        <img class="about-photo" src="{{ asset('images/profile.png') }}" alt="Photo de {{ name }}">

        <div class="about-content">
            <h2>À propos de moi</h2>
            {% for paragraph in about %}
                <p>{{ paragraph }}</p>
            {% endfor %}
            {% if highlights|length > 0 %}
                <ul class="about-highlights">
                    {% for highlight in highlights %}
                        <li>{{ highlight }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>

        {% if stats|length > 0 %}
            <div class="about-stats">
                {% for stat in stats %}
                    <div class="about-stats__item">
                        <span class="about-stats__number">{{ stat.number }}</span>
                        <span class="about-stats__label">{{ stat.label }}</span>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        {% if skills|length > 0 %}
            <ul class="project-card__stack about-skills">
                {% for skill in skills %}
                    <li>{{ skill }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    {% if experiences|length > 0 %}
        <section class="experience" id="experience">
            <h2>Expérience</h2>
            <div class="experience__list">
                {% for experience in experiences %}
                    <article class="experience-item">
                        <div class="experience-item__marker" aria-hidden="true"></div>
                        <div class="experience-item__body">
                            <p class="experience-item__period">{{ experience.period }}</p>
                            <h3>{{ experience.role }}</h3>
                            <p class="experience-item__company">
                                {{ experience.company }}{% if experience.location %} · {{ experience.location }}{% endif %}
                            </p>
                            {% if experience.descriptionLines|length > 0 %}
                                <ul class="experience-item__description">
                                    {% for line in experience.descriptionLines %}
                                        <li>{{ line }}</li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {% if projects|length > 0 %}
        <section class="projects" id="projects">
            <h2>Projets</h2>
            <div class="projects__list">
                {% for project in projects %}
                    {% set coverImage = project.images|length > 0 ? project.images|first : null %}
                    <article class="project-card">
                        {% if project.coverVideoName %}
                            <video class="project-card__image" data-controller="cover-video"
                                   src="{{ asset('uploads/projects/' ~ project.coverVideoName) }}"
                                   autoplay muted loop playsinline></video>
                        {% elseif coverImage %}
                            <img class="project-card__image" src="{{ asset('uploads/projects/' ~ coverImage.imageName) }}" alt="{{ project.title }}" loading="lazy">
                        {% endif %}

                        <div class="project-card__body">
                            <h3><a href="{{ path('project_show', {slug: project.slug}) }}" class="project-card__stretched-link">{{ project.title }}</a></h3>
                            <p>{{ project.description }}</p>
                            <ul class="project-card__stack">
                                {% for tech in project.stackList %}
                                    <li>{{ tech }}</li>
                                {% endfor %}
                            </ul>
                            <div class="project-card__links">
                                {% if project.githubUrl %}
                                    <a href="{{ project.githubUrl }}" target="_blank" rel="noopener">GitHub →</a>
                                {% endif %}
                                {% if project.demoUrl %}
                                    <a href="{{ project.demoUrl }}" target="_blank" rel="noopener">Démo →</a>
                                {% endif %}
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {% if certificates|length > 0 %}
        <section class="certificates" id="certificates">
            <h2>Certificats</h2>
            <div class="certificates__list">
                {% for certificate in certificates %}
                    <article class="certificate-card">
                        <div class="certificate-card__badge">
                            {% if certificate.badgeImageName %}
                                <img src="{{ asset('uploads/certificates/' ~ certificate.badgeImageName) }}" alt="">
                            {% else %}
                                <span class="certificate-card__initial">{{ certificate.title|first|upper }}</span>
                            {% endif %}
                        </div>
                        <div class="certificate-card__body">
                            <h3>{{ certificate.title }}</h3>
                            <p class="certificate-card__issuer">{{ certificate.issuer }}</p>
                            {% if certificate.issueDate %}
                                <p class="certificate-card__date">{{ certificate.issueDate|date('F Y') }}</p>
                            {% endif %}
                            {% if certificate.credentialUrl %}
                                <a href="{{ certificate.credentialUrl }}" target="_blank" rel="noopener" class="certificate-card__link">Vérifier →</a>
                            {% endif %}
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>
    {% endif %}
{% endblock %}
