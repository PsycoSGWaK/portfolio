{% extends 'base.html.twig' %}

{% block title %}{{ name }}{% endblock %}

{% block body %}
    <section class="hero">
        <h1>{{ name }}</h1>
    </section>

    <section class="about">
        <h2>À propos</h2>
        {% for paragraph in about %}
            <p>{{ paragraph }}</p>
        {% endfor %}
    </section>

    {% if projects|length > 0 %}
        <section class="projects">
            <h2>Projets</h2>
            <div class="projects__list">
                {% for project in projects %}
                    <article class="project-card">
                        {% if project.images|length > 0 %}
                            <div class="project-card__carousel" data-controller="carousel">
                                <div class="project-card__track" data-carousel-target="track">
                                    {% for image in project.images %}
                                        <img class="project-card__image" src="{{ asset('uploads/projects/' ~ image.imageName) }}" alt="{{ project.title }}" loading="lazy">
                                    {% endfor %}
                                </div>
                                {% if project.images|length > 1 %}
                                    <button type="button" class="project-card__nav project-card__nav--prev" data-action="carousel#prev" aria-label="Image précédente">‹</button>
                                    <button type="button" class="project-card__nav project-card__nav--next" data-action="carousel#next" aria-label="Image suivante">›</button>
                                {% endif %}
                            </div>
                        {% endif %}

                        <div class="project-card__body">
                            <h3>{{ project.title }}</h3>
                            <p>{{ project.description }}</p>
                            <ul class="project-card__stack">
                                {% for tech in project.stackList %}
                                    <li>{{ tech }}</li>
                                {% endfor %}
                            </ul>
                            <div class="project-card__links">
                                {% if project.githubUrl %}
                                    <a href="{{ project.githubUrl }}" target="_blank" rel="noopener">GitHub →</a>
                                {% endif %}
                                {% if project.demoUrl %}
                                    <a href="{{ project.demoUrl }}" target="_blank" rel="noopener">Démo →</a>
                                {% endif %}
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>
    {% endif %}
{% endblock %}
