{% extends 'base.html.twig' %}

{% block title %}{{ project.title }}{% endblock %}

{% block nav %}
    <header class="site-nav">
        <div class="site-nav__inner">
            <a href="{{ path('home') }}" class="site-nav__name">Guillaume Hurard</a>
            {{ include('_theme_toggle.html.twig') }}
        </div>
    </header>
{% endblock %}

{% block body %}
    <article class="project-detail">
        <a href="{{ path('home') }}" class="project-detail__back">← Retour aux projets</a>

        <header class="project-detail__header">
            <div class="project-detail__heading">
                <p class="project-detail__eyebrow">
                    Projet{% if project.createdAt %} · {{ project.createdAt|format_date(pattern: 'MMMM yyyy') }}{% endif %}
                </p>
                <h1>{{ project.title }}</h1>
            </div>
            <div class="project-detail__actions">
                {{ include('project/_links.html.twig', {project: project}) }}
            </div>
        </header>

        {% if project.images|length > 0 %}
            <div class="project-gallery" data-controller="carousel">
                <div class="project-gallery__track" data-carousel-target="track">
                    {% for image in project.images %}
                        <img class="project-gallery__image" src="{{ asset('uploads/projects/' ~ image.imageName) }}" alt="{{ project.title }}" loading="lazy">
                    {% endfor %}
                </div>
                {% if project.images|length > 1 %}
                    <button type="button" class="project-gallery__nav project-gallery__nav--prev" data-action="carousel#prev" aria-label="Image précédente">‹</button>
                    <button type="button" class="project-gallery__nav project-gallery__nav--next" data-action="carousel#next" aria-label="Image suivante">›</button>
                {% endif %}
            </div>
        {% elseif project.coverVideoName %}
            <div class="project-gallery">
                <video class="project-gallery__image" src="{{ asset('uploads/projects/' ~ project.coverVideoName) }}" autoplay muted loop playsinline></video>
            </div>
        {% endif %}

        {% if project.description or project.role %}
            <div class="project-detail__meta">
                {% if project.description %}
                    <div class="project-detail__meta-item">
                        <h2>Description</h2>
                        <p>{{ project.description }}</p>
                    </div>
                {% endif %}
                {% if project.role %}
                    <div class="project-detail__meta-item">
                        <h2>Rôle</h2>
                        <p>{{ project.role }}</p>
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {% if project.context %}
            <div class="project-detail__meta">
                <div class="project-detail__meta-item">
                    <h2>Contexte</h2>
                    <p>{{ project.context }}</p>
                </div>
            </div>
        {% endif %}

        <div class="project-detail__body">
            {% if project.objectiveLines|length > 0 %}
                <h2 class="project-detail__section-title">Objectifs</h2>
                <ul class="project-detail__list">
                    {% for item in project.objectiveLines %}
                        <li>{{ item }}</li>
                    {% endfor %}
                </ul>
            {% endif %}

            {% if project.stackList|length > 0 %}
                <ul class="project-card__stack">
                    {% for tech in project.stackList %}
                        <li>{{ tech }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </article>
{% endblock %}
