{% extends 'base.html.twig' %}
{% import '_tech_icon.html.twig' as techIcons %}

{% block title %}{{ project.title }}{% endblock %}

{% block nav %}
    <header class="site-nav">
        <div class="site-nav__inner">
            <a href="{{ path('home') }}" class="site-nav__name">Guillaume Hurard</a>
            <div class="site-nav__right">
                {{ include('_locale_switcher.html.twig') }}
                {{ include('_theme_toggle.html.twig') }}
            </div>
        </div>
    </header>
{% endblock %}

{% block body %}
    {% set locale = app.request.locale %}
    <article class="project-detail">
        <a href="{{ path('home') }}" class="project-detail__back">← {{ 'Retour aux projets'|trans }}</a>

        <header class="project-detail__header">
            <div class="project-detail__heading">
                <p class="project-detail__eyebrow">{{ 'Projet'|trans }}</p>
                <h1>{{ project.title }}</h1>
            </div>
            <div class="project-detail__actions">
                {{ include('project/_links.html.twig', {project: project}) }}
            </div>
        </header>

        {% if project.images|length > 0 %}
            <div class="project-gallery" data-controller="carousel">
                <div class="project-gallery__track" data-carousel-target="track">
                    {% for image in project.images %}
                        <img class="project-gallery__image" src="{{ asset('uploads/projects/' ~ image.imageName) }}" alt="{{ project.title }}" loading="lazy">
                    {% endfor %}
                </div>
                {% if project.images|length > 1 %}
                    <button type="button" class="project-gallery__nav project-gallery__nav--prev" data-action="carousel#prev" aria-label="{{ 'Image précédente'|trans }}">‹</button>
                    <button type="button" class="project-gallery__nav project-gallery__nav--next" data-action="carousel#next" aria-label="{{ 'Image suivante'|trans }}">›</button>
                {% endif %}
            </div>
        {% elseif project.coverVideoName %}
            <div class="project-gallery">
                <video class="project-gallery__image" src="{{ asset('uploads/projects/' ~ project.coverVideoName) }}" autoplay muted loop playsinline></video>
            </div>
        {% endif %}

        {% if project.description or project.role|length > 0 or project.stackList|length > 0 or project.toolsList|length > 0 %}
            <div class="project-detail__meta project-detail__meta--grid">
                {% if project.description %}
                    <div class="project-detail__meta-item project-detail__meta-item--description">
                        <h2>{{ 'Description'|trans }}</h2>
                        <p>{{ project.getLocalizedDescription(locale) }}</p>
                    </div>
                {% endif %}
                {% if project.role|length > 0 %}
                    <div class="project-detail__meta-item project-detail__meta-item--role">
                        <h2>{{ 'Rôle'|trans }}</h2>
                        {% for r in project.role %}
                            <p>{{ r }}</p>
                        {% endfor %}
                    </div>
                {% endif %}
                {% if project.stackList|length > 0 or project.toolsList|length > 0 %}
                    <div class="project-detail__meta-item project-detail__meta-item--stack">
                        {% if project.stackList|length > 0 %}
                            <h2>{{ 'Stack technique'|trans }}</h2>
                            <ul class="tech-chip-list">
                                {% for tech in project.stackList %}
                                    <li class="tech-chip">
                                        {% set slug = tech_icon_slug(tech) %}
                                        {% if slug %}{{ techIcons.render(slug) }}{% endif %}
                                        {{ tech }}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                        {% if project.toolsList|length > 0 %}
                            <h2{% if project.stackList|length > 0 %} class="project-detail__meta-item-heading--spaced"{% endif %}>{{ 'Outils'|trans }}</h2>
                            <ul class="tech-chip-list">
                                {% for tool in project.toolsList %}
                                    <li class="tech-chip">
                                        {% set slug = tech_icon_slug(tool) %}
                                        {% if slug %}{{ techIcons.render(slug) }}{% endif %}
                                        {{ tool }}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {% set localizedContext = project.getLocalizedContext(locale) %}
        {% if localizedContext %}
            <div class="project-detail__meta">
                <div class="project-detail__meta-item">
                    <h2>{{ 'Contexte'|trans }}</h2>
                    <p>{{ localizedContext }}</p>
                </div>
            </div>
        {% endif %}

        {% set objectiveLines = project.getLocalizedObjectiveLines(locale) %}
        {% set featureLines = project.getLocalizedFeatureLines(locale) %}
        {% if objectiveLines|length > 0 or featureLines|length > 0 %}
            <div class="project-detail__body">
                <div class="project-detail__pair">
                    {% if objectiveLines|length > 0 %}
                        <div>
                            <h2 class="project-detail__section-title">{{ 'Objectifs'|trans }}</h2>
                            <ul class="project-detail__list">
                                {% for item in objectiveLines %}
                                    <li>{{ item }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    {% if featureLines|length > 0 %}
                        <div>
                            <h2 class="project-detail__section-title">{{ 'Fonctionnalités importantes'|trans }}</h2>
                            <ul class="project-detail__list">
                                {% for item in featureLines %}
                                    <li>{{ item }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </article>
{% endblock %}
