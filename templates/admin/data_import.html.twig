{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Import de données{% endblock %}

{% block main %}
    <div class="content-panel">
        <div class="content-panel-body">
            <p>
                Remplace <strong>tous</strong> les projets, certificats, expériences et formations actuels par le
                contenu d'un fichier exporté depuis <a href="{{ path('admin_data_export') }}">Exporter les données</a>.
                Les fichiers uploadés (images, vidéos, logos) ne sont pas inclus dans l'export : copie-les séparément
                sur le serveur cible si besoin.
            </p>

            <form method="post" enctype="multipart/form-data">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_data_import') }}">

                <div class="form-group">
                    <label for="export_file">Fichier JSON exporté</label>
                    <input type="file" id="export_file" name="export_file" accept="application/json" required class="form-control">
                </div>

                <div class="form-group form-check" style="margin-top: 1rem;">
                    <input type="checkbox" id="confirm" name="confirm" value="1" class="form-check-input" required>
                    <label for="confirm" class="form-check-label">
                        Je comprends que ceci remplace toutes les données existantes et ne peut pas être annulé.
                    </label>
                </div>

                <button type="submit" class="btn btn-primary" style="margin-top: 1rem;">Importer</button>
            </form>
        </div>
    </div>
{% endblock %}
